# Variables to set in Vercel (Project Settings > Environment Variables). Never commit real values.
# Set Production and Preview separately; use a different SECRET_KEY and database for each.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_ALLOWED_HOSTS=         # e.g. dhedak.com,www.dhedak.com (Vercel hostnames are added automatically)
FRONTEND_URL=                 # e.g. https://dhedak.com
DATABASE_URL=                 # Supabase TRANSACTION pooler string (port 6543), from the dashboard's Connect panel
SUPPORTED_COUNTRIES=GH,CM,UG
