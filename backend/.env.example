# Copy to .env for local development. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
# Leave EMPTY for local dev and tests (uses SQLite). `manage.py test` with a Postgres URL would try to
# create a test database on Supabase. Pass the Supabase URL inline only when running `migrate`.
DATABASE_URL=
