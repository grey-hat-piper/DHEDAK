# Copy to .env for local development. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
# Leave EMPTY for local dev (uses SQLite). Pass the Supabase URL inline only when running `migrate`.
# `manage.py test` ignores DATABASE_URL on purpose; set TEST_DATABASE_URL to a LOCAL Postgres+PostGIS to test there.
DATABASE_URL=
